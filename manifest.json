{
  "manifest_version": 3,
  "name": "Digital Garden",
  "version": "0.1.0",
  "action": {
    "default_popup": "src/popup/index.html" 
  },
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"]
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"]
}